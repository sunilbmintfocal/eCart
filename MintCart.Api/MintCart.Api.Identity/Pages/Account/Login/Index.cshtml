@page
@model MintCart.Pages.Login.Index

@{
    Layout = "_Layout";
}

@section styles {
    <link rel="stylesheet" href="~/css/emerald-theme.css" />
}

<div class="login-page-wrapper">
    <div class="split-login-container">
        <!-- Left Panel: Image and Value Prop -->
        <div class="login-image-panel">
        </div>

        <!-- Right Panel: Login Form -->
        <div class="login-form-panel">
            <div class="brand-section">
                <div class="brand-icon">
                    <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M8 12C8 12 10 4 20 4C30 4 32 12 32 12C32 12 34 26 20 26C6 26 8 12 8 12Z" fill="#3EB489" />
                        <path d="M20 4V26" stroke="white" stroke-width="2" stroke-linecap="round" />
                        <path d="M20 10L26 4M20 16L14 10" stroke="white" stroke-width="2" stroke-linecap="round" />
                        <circle cx="14" cy="32" r="3" fill="#36454F" />
                        <circle cx="26" cy="32" r="3" fill="#36454F" />
                        <path d="M14 32H26" stroke="#36454F" stroke-width="2" />
                    </svg>
                </div>
                <span><b>MINT</b><span class="mint-text">CART</span></span>
            </div>

            <div class="login-header">
                <h2>Account Login</h2>
                <p>Enter your email and password to access your account.</p>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger" style="font-size: 0.8rem; border-radius: 0px; padding: 0.75rem;">
                    <div asp-validation-summary="All"></div>
                </div>
            }

            @if (Model.View.EnableLocalLogin)
            {
                <form asp-page="/Account/Login/Index">
                    <input type="hidden" asp-for="Input.ReturnUrl" />

                    <div class="form-group">
                        <input class="emerald-input" placeholder="customer@MintCart.com" asp-for="Input.Username" autofocus>
                    </div>

                    <div class="form-group">
                        <div class="password-row">
                            <label class="form-label" asp-for="Input.Password">Password</label>
                        </div>
                        <input type="password" class="emerald-input" placeholder="••••••••" asp-for="Input.Password" autocomplete="off">
                    </div>
                    

                    
                    <button class="btn-sign-in" name="Input.Button" value="login">
                        Sign In <span>→</span>
                    </button>
                </form>
            }



            <div class="login-footer">
                <span>System V. 4.8.2</span>
            </div>
        </div>
    </div>
</div>

