@page
@model eCartIdentity.Pages.Login.Index

@{
    Layout = "_Layout";
}

@section styles {
    <link rel="stylesheet" href="~/css/emerald-theme.css" />
}

<div class="login-page-wrapper">
    <div class="split-login-container">
        <!-- Left Panel: Image and Value Prop -->
        <div class="login-image-panel">
            <div class="reliability-card">
                <h4>RETAIL OPERATIONS HUB</h4>
                <p>Manage daily sales, track real-time inventory, and generate comprehensive stock reports with surgical precision.</p>
            </div>
        </div>

        <!-- Right Panel: Login Form -->
        <div class="login-form-panel">
            <div class="brand-section">
                <div class="brand-icon">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4H6z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
                </div>
                <span>eCart</span>
            </div>

            <div class="login-header">
                <h2>Account Login</h2>
                <p>Enter your email and password to access your account.</p>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger" style="font-size: 0.8rem; border-radius: 0px; padding: 0.75rem;">
                    <div asp-validation-summary="All"></div>
                </div>
            }

            @if (Model.View.EnableLocalLogin)
            {
                <form asp-page="/Account/Login/Index">
                    <input type="hidden" asp-for="Input.ReturnUrl" />

                    <div class="form-group">
                        <input class="emerald-input" placeholder="customer@ecart.com" asp-for="Input.Username" autofocus>
                    </div>

                    <div class="form-group">
                        <div class="password-row">
                            <label class="form-label" asp-for="Input.Password">Password</label>
                        </div>
                        <input type="password" class="emerald-input" placeholder="••••••••" asp-for="Input.Password" autocomplete="off">
                    </div>
                    

                    
                    <button class="btn-sign-in" name="Input.Button" value="login">
                        Sign In <span>→</span>
                    </button>
                </form>
            }



            <div class="login-footer">
                <span>System V. 4.8.2</span>
            </div>
        </div>
    </div>
</div>

